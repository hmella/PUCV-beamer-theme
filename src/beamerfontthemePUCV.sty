\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerfontthemePUCV}[2026/10/05 v2.1 Tema de fuentes beamer PUCV]

\RequirePackage{iftex}

\mode<presentation>

% Roboto para el texto y Roboto Mono para \texttt y el código (legible y
% coherente con el texto). En pdfLaTeX se usan los paquetes roboto y
% roboto-mono (fuentes Type 1, codificación T1). En LuaLaTeX y XeLaTeX las
% fuentes OpenType se cargan directamente con fontspec: el paquete roboto
% exige además Roboto Slab, que no viene en algunas distribuciones (p. ej.
% TeX Live de Debian/Ubuntu) y que el tema no usa.
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage[sfdefault]{roboto}
  \RequirePackage{roboto-mono}
\else
  \RequirePackage{fontspec}
  \setsansfont{Roboto}[
    Extension      = .otf,
    UprightFont    = *-Regular,
    BoldFont       = *-Bold,
    ItalicFont     = *-Italic,
    BoldItalicFont = *-BoldItalic,
    Ligatures      = TeX]
  \setmonofont{RobotoMono}[
    Extension      = .otf,
    UprightFont    = *-Regular,
    BoldFont       = *-Bold,
    ItalicFont     = *-Italic,
    BoldItalicFont = *-BoldItalic]
  \renewcommand*{\familydefault}{\sfdefault}
\fi

\setbeamerfont{title}{size=\LARGE, series=\bfseries}
\setbeamerfont{subtitle}{size=\large, series=\mdseries}
\setbeamerfont{author}{size=\normalsize, series=\bfseries}
\setbeamerfont{institute}{size=\small}
\setbeamerfont{date}{size=\small}

\setbeamerfont{frametitle}{size=\Large, series=\bfseries}
\setbeamerfont{framesubtitle}{size=\small, series=\mdseries}

\setbeamerfont{section title}{size=\huge, series=\bfseries}
\setbeamerfont{section number}{size=\Huge, series=\bfseries}

\setbeamerfont{closing}{size=\LARGE, series=\bfseries}

\setbeamerfont{block title}{size=\normalsize, series=\bfseries}
\setbeamerfont{footline}{size=\tiny}
\setbeamerfont{page number in head/foot}{size=\tiny}
\setbeamerfont{caption}{size=\small}
\setbeamerfont{caption name}{series=\bfseries}
\setbeamerfont{section in toc}{series=\bfseries}
\setbeamerfont{enumerate item}{series=\bfseries}

\mode<all>

\endinput
