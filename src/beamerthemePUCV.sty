%%
%% Uso:
%%   \usetheme[<clave>=<valor>, ...]{PUCV}
%%
%% Opciones:
%%   mode        = light | dark | institutional (por defecto: light)
%%   centenary   = true | false                 (por defecto: true; solo en
%%                                               mode=institutional)
%%   accent      = blue | red | gold            (por defecto: blue)
%%   progressbar = foot | head | none           (por defecto: foot)
%%   sectionpage = true | false                 (por defecto: true)
%%   numbering   = fraction | counter | none    (por defecto: fraction)
%%   titleimage  = <archivo> | none             (por defecto: dibujo de la Casa Central)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemePUCV}[2026/10/05 v2.1 Tema beamer PUCV]

\RequirePackage{pgfopts}

\mode<presentation>

%% ---------------------------------------------------------------------------
%% Opciones
%% ---------------------------------------------------------------------------
\newif\ifpucv@dark
\newif\ifpucv@institutional
\newif\ifpucv@centenary
\newif\ifpucv@sectionpage

\pgfkeys{
  /pucv/.is family, /pucv,
  mode/.is choice,
  mode/light/.code       = \pucv@darkfalse\pucv@institutionalfalse,
  mode/dark/.code        = \pucv@darktrue\pucv@institutionalfalse,
  mode/institutional/.code = \pucv@darkfalse\pucv@institutionaltrue,
  centenary/.is if       = pucv@centenary,
  accent/.is choice,
  accent/blue/.code      = \def\pucv@accent{blue},
  accent/red/.code       = \def\pucv@accent{red},
  accent/gold/.code      = \def\pucv@accent{gold},
  progressbar/.is choice,
  progressbar/foot/.code = \def\pucv@progressbar{foot},
  progressbar/head/.code = \def\pucv@progressbar{head},
  progressbar/none/.code = \def\pucv@progressbar{none},
  sectionpage/.is if     = pucv@sectionpage,
  numbering/.is choice,
  numbering/fraction/.code = \def\pucv@numbering{fraction},
  numbering/counter/.code  = \def\pucv@numbering{counter},
  numbering/none/.code     = \def\pucv@numbering{none},
  titleimage/.store in   = \pucv@titleimage,
  % Valores por defecto
  mode        = light,
  centenary   = true,
  accent      = blue,
  progressbar = foot,
  sectionpage = true,
  numbering   = fraction,
  titleimage  = default,
}
\ProcessPgfPackageOptions{/pucv}

%% ---------------------------------------------------------------------------
%% Subtemas
%% ---------------------------------------------------------------------------
\usecolortheme{PUCV}
\usefonttheme{PUCV}
\useinnertheme{PUCV}
\useoutertheme{PUCV}

\beamertemplatenavigationsymbolsempty

%% ---------------------------------------------------------------------------
%% Traducciones al español de los entornos de beamer (solo se aplican cuando el
%% documento está en español, p. ej. con \usepackage[spanish]{babel}).
%% ---------------------------------------------------------------------------
% Según la versión de babel, el idioma se identifica como `Spanish' o
% `spanish', por lo que se registran ambos.
\newcommand*{\pucv@spanish}[2]{%
  \deftranslation[to=Spanish]{#1}{#2}%
  \deftranslation[to=spanish]{#1}{#2}%
}
\pucv@spanish{Theorem}{Teorema}
\pucv@spanish{Corollary}{Corolario}
\pucv@spanish{Fact}{Hecho}
\pucv@spanish{Lemma}{Lema}
\pucv@spanish{Problem}{Problema}
\pucv@spanish{Solution}{Solución}
\pucv@spanish{Definition}{Definición}
\pucv@spanish{Definitions}{Definiciones}
\pucv@spanish{Example}{Ejemplo}
\pucv@spanish{Examples}{Ejemplos}
\pucv@spanish{Proof}{Demostración}

%% ---------------------------------------------------------------------------
%% Portada: \maketitle genera una diapositiva de portada a sangre y sin numerar.
%% ---------------------------------------------------------------------------
\renewcommand*{\maketitle}{%
  \ifbeamer@inframe
    \titlepage
  \else
    {%
      \setbeamertemplate{background}[pucv title]%
      \frame[plain,noframenumbering,t]{\titlepage}%
    }%
  \fi
}

%% ---------------------------------------------------------------------------
%% Diapositivas separadoras de sección automáticas
%% ---------------------------------------------------------------------------
% El fondo `pucv section' es el fondo normal en los modos claro y oscuro, y una
% banda a sangre en el modo institucional.
\ifpucv@sectionpage
  \AtBeginSection{%
    \ifbeamer@inframe
      \sectionpage
    \else
      {%
        \setbeamertemplate{background}[pucv section]%
        \frame[plain,noframenumbering]{\sectionpage}%
      }%
    \fi
  }
\fi

%% ---------------------------------------------------------------------------
%% Diapositiva de cierre: \makeclosing[<contacto>]{<mensaje>}
%% ---------------------------------------------------------------------------
\newcommand*{\makeclosing}[2][]{%
  {%
    \def\pucv@closingcontact{#1}%
    \def\pucv@closingmessage{#2}%
    \setbeamertemplate{background}[pucv closing]%
    \frame[plain,noframenumbering,c]{\usebeamertemplate{closing page}}%
  }%
}

\mode<all>

\endinput
